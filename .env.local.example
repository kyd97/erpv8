# Copy to .env.local, fill in the real values, then start the app with
#   source .env.local && ./run-dev.sh
# .env.local is git-ignored and must never be committed.
export ERPV8_DB_HOST=127.0.0.1
export ERPV8_DB_PORT=3306
export ERPV8_DB_USER=root
export ERPV8_DB_PASS=
export ERPV8_DB_NAME=erpv8

# development shows PHP errors and notices; use production in real deployments
export ERPV8_ENV=development
